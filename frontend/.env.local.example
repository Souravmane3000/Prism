# Prism Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.

# ── Supabase (public keys — safe for the browser) ────────────────────────────
# Project URL from Supabase dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Anon (public) key — used only for Realtime subscriptions, never service role
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── FastAPI backend (Modal web endpoint) ─────────────────────────────────────
# The URL of your deployed Modal FastAPI app (e.g. https://your-workspace--prism-api.modal.run)
# In local development, use http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=https://your-workspace--prism-api.modal.run
