# ── LLM (OpenAI) ──────────────────────────────────────────────────────────────
# Official OpenAI API key — used for gpt-4o-mini chat and text-embedding-3-small
OPENAI_API_KEY=sk-...

# Chat model used by Planner, Implementation Planner, Debugger, PR Summarizer
OPENAI_MODEL_NAME=gpt-4o-mini

# Embedding model used by Code Navigator (1536 dims, matches pgvector schema)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── LangSmith (tracing) ───────────────────────────────────────────────────────
# API key from https://smith.langchain.com — enables auto-tracing for all runs
LANGSMITH_API_KEY=lsv2_...

# LangChain project name — must be exactly "prism" per architecture decision
LANGCHAIN_PROJECT=prism

# ── Supabase ──────────────────────────────────────────────────────────────────
# Project URL from Supabase dashboard → Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Service role key — has full DB access; backend only, never expose to frontend
SUPABASE_SERVICE_KEY=eyJ...

# Anon/public key — safe to embed in frontend for Realtime subscriptions
SUPABASE_ANON_KEY=eyJ...

# LangGraph checkpointer — use Session pooler (IPv4), NOT db.<ref>.supabase.co
# Direct db.* hosts are IPv6-only on the free tier and fail on Windows with getaddrinfo.
# Dashboard → Connect → Session pooler (port 5432). Encode special chars in the password (* → %2A).
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=postgresql://postgres.yourref:password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Application ───────────────────────────────────────────────────────────────
# Runtime environment — controls logging verbosity and CORS strictness
ENVIRONMENT=development

# Allowed CORS origin(s) for the frontend — comma-separated, no trailing slash.
# Production aliases plus localhost. Vercel preview URLs (prism-<hash>-*.vercel.app)
# are allowed by a scoped regex in backend/config.py — do not set origin to *.
# Production example: https://prism-beta-one.vercel.app,https://prism-sourav-manes-projects.vercel.app
FRONTEND_ORIGIN=http://localhost:3000

# ── Frontend (Vercel / Next.js) ───────────────────────────────────────────────
# Set these in the Vercel project (frontend Root Directory), not in Modal.
# NEXT_PUBLIC_API_BASE_URL is the Modal web URL with no trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://your-modal-app.modal.run
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# ── Local development only ────────────────────────────────────────────────────
# GitHub Personal Access Token for local testing — NEVER commit a real token
# In production, users supply their own PAT per API request; this is dev-only
GITHUB_TEST_TOKEN=ghp_...
